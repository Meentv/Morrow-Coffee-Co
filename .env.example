# ---------------------------------------------------------------------------
# Morrow Coffee Co. — environment variables
#
# Copy to `.env.local` for development (Vite loads it automatically).
# Only VITE_-prefixed variables are exposed to the browser bundle.
# NEVER put secrets in a VITE_ variable — they ship to every visitor.
# ---------------------------------------------------------------------------

# Public origin of the deployed site, no trailing slash.
# Used for canonical URLs and absolute Open Graph / Twitter image URLs.
# Leave empty until the real domain is confirmed: the app then omits
# <link rel="canonical"> rather than pointing at a made-up host.
# VITE_SITE_URL=https://www.example.com

# Base URL of the form-submission backend, no trailing slash.
# While this is empty the app runs in DEMO MODE: submissions are simulated,
# the UI labels them as demos, and nothing is sent anywhere.
# VITE_API_BASE_URL=https://api.example.com
#
# Expected endpoints (same shape, JSON in / JSON out, `{ reference }` back):
#   POST {VITE_API_BASE_URL}/orders
#   POST {VITE_API_BASE_URL}/kitchen-enquiries
#   POST {VITE_API_BASE_URL}/contact
#   POST {VITE_API_BASE_URL}/newsletter

# Optional: analytics id (not wired up yet — documented so it is not invented later).
# VITE_ANALYTICS_ID=
